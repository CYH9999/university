{
  "name": "unios",
  "private": true,
  "version": "1.0.0",
  "description": "UniOS — offline-first university life manager for cybersecurity students",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:i18n": "vitest run tests/i18n.test.ts",
    "assets": "node scripts/copy-excalidraw-assets.mjs",
    "tauri": "tauri",
    "postinstall": "node scripts/copy-excalidraw-assets.mjs"
  },
  "dependencies": {
